{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "server/**",
      "client/**",
      "protocol/**",
      "scripts/**",
      "bridge/package.json",
      "package.json",
      "package-lock.json",
      "Dockerfile",
      ".dockerignore",
      "railway.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/api/health"
  }
}
